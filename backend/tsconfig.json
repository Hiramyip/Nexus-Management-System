{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    
    "paths": {
      "../prisma/*": ["../prisma/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}