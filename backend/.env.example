# Prisma database selection: use sqlserver or mongodb
PRISMA_TARGET_DB=sqlserver

# SQL Server connection string for Prisma
SQL_SERVER_URL=sqlserver://dbadmin:password@host:1433/database?encrypt=true&trustServerCertificate=true

# MongoDB connection string for Prisma
MONGODB_URL=mongodb://username:password@host:27017/database

# CORS origins allowed for frontend and backend hosting.
# También se permiten dinámicamente dominios Vercel (*.vercel.app) y Render (*.onrender.com).
CORS_ORIGINS=https://nexus-management-system-gamma.vercel.app,https://nexus-backend-2pm4.onrender.com,http://localhost:3000

# Excel Processor Service URL
EXCEL_PROCESSOR_URL=http://localhost:8003

# Server Settings
PORT=8000
UPLOAD_DIR=/app/uploads
