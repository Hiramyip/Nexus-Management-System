generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model CasasQuemadas {
  idCasaQuemada  Int          @id(map: "PK__CasasQue__C234F3C1E5BBC817") @default(autoincrement())
  idGrupoTrabajo Int
  ubicacion      String       @db.VarChar(100)
  fecha          DateTime?    @db.Date
  metroLineal    Int?
  metroCuadrado  Int?
  metroCubico    Decimal?     @db.Decimal(10, 2)
  peso           Decimal?     @db.Decimal(10, 2)
  GrupoTrabajo   GrupoTrabajo @relation(fields: [idGrupoTrabajo], references: [idGrupoTrabajo], onUpdate: NoAction, map: "FK__CasasQuema__peso__59FA5E80")
}

